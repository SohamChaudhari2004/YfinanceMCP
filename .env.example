# Required for /api/v1/chat
GROQ_API_KEY=

# Comma-separated list of accepted X-API-Key values. Leave empty to disable the check (local dev only).
API_KEYS=

# Allowed browser origins besides localhost / 127.0.0.1 (any port, always allowed).
CORS_ORIGINS=https://sohamchaudhari.in

# Optional
GROQ_MODEL=openai/gpt-oss-120b
RATE_LIMIT_CHAT=10/minute;200/day
RATE_LIMIT_DATA=60/minute
CHECKPOINT_DB=data/checkpoints.sqlite
MAX_HISTORY_MESSAGES=30
AGENT_TIMEOUT_SECONDS=90
DOCS_ENABLED=true
